{
  "schema": {
    "url": "https://ddns.newfuture.cc/schema/v4.1.json",
    "values": [
      "https://ddns.newfuture.cc/schema/v4.1.json",
      "http://ddns.newfuture.cc/schema/v4.1.json",
      "./schema/v4.1.json"
    ]
  },
  "defaults": {
    "provider": "debug",
    "index": [
      "public",
      "default"
    ],
    "ssl": "auto",
    "proxy": [],
    "cache": true,
    "cacheMaxAge": 259200,
    "interval": 5,
    "logLevel": "INFO"
  },
  "limits": {
    "providers": 128
  },
  "rules": {
    "domainPattern": "^(?:\\*\\.)?(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,18}$",
    "proxyPattern": "^(https?://[a-zA-Z0-9\\-_:\\.]+|[a-zA-Z0-9\\-_:\\.]+:[0-9]+|DIRECT|SYSTEM|DEFAULT)$",
    "logLevels": [
      "DEBUG",
      "INFO",
      "WARNING",
      "ERROR",
      "CRITICAL"
    ],
    "addressSourceNames": [
      "default",
      "local",
      "public"
    ],
    "addressSourcePrefixes": [
      "url:",
      "regex:",
      "cmd:",
      "shell:"
    ],
    "falseAliases": [
      "false",
      "none"
    ],
    "booleanTrueAliases": [
      "yes",
      "true",
      "t",
      "y",
      "1"
    ],
    "booleanFalseAliases": [
      "no",
      "false",
      "f",
      "n",
      "0"
    ],
    "legacyProviderKeys": [
      "dns",
      "provider",
      "id",
      "token",
      "ipv4",
      "ipv6",
      "endpoint"
    ],
    "flatLogKeys": [
      "log_level",
      "log_file",
      "log_format",
      "log_datefmt"
    ],
    "reservedExtraKeys": [
      "domain",
      "value",
      "record_type",
      "ttl",
      "line"
    ],
    "commonConfigKeys": [
      "$schema",
      "dns",
      "id",
      "token",
      "endpoint",
      "ipv4",
      "ipv6",
      "index4",
      "index6",
      "ttl",
      "line",
      "proxy",
      "cache",
      "cache_max_age",
      "interval",
      "http",
      "ssl",
      "log",
      "extra",
      "debug",
      "config",
      "command"
    ]
  },
  "providers": [
